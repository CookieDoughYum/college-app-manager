generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Counter {
  id    Int    @id @default(autoincrement())
  name  String @unique
  value Int    @default(0)
}

// Runtime configuration store for admin-managed credentials.
model Config {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Student {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  highSchool   String
  grade        Int      // 8–12
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  activities   StudentActivities?
  exams        StudentExams?
  colleges     StudentColleges?
  essays       StudentEssays?
  recLetters   StudentRecLetters?
  portals      StudentPortals?
  decide       StudentDecide?
  financialAid StudentFinancialAid?
  deadlines    StudentDeadlines?
}

model StudentActivities {
  id                 Int      @id @default(autoincrement())
  studentId          Int      @unique
  student            Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  interests          Json     @default("[]")
  coursePlan         Json     @default("{}")
  aiRecommendations  Json     @default("{}")
  updatedAt          DateTime @updatedAt
}

model StudentExams {
  id                Int      @id @default(autoincrement())
  studentId         Int      @unique
  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  testPreference    String?
  apCourses         Json     @default("[]")
  aiRecommendations Json     @default("{}")
  updatedAt         DateTime @updatedAt
}

model StudentColleges {
  id                Int      @id @default(autoincrement())
  studentId         Int      @unique
  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  majorAnswers      Json     @default("{}")
  collegeList       Json     @default("[]")
  aiRecommendations Json     @default("{}")
  updatedAt         DateTime @updatedAt
}

model StudentEssays {
  id        Int      @id @default(autoincrement())
  studentId Int      @unique
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  driveLink String?
  notes     String?
  updatedAt DateTime @updatedAt
}

model StudentRecLetters {
  id        Int      @id @default(autoincrement())
  studentId Int      @unique
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  checklist Json     @default("{}")
  teachers  Json     @default("[]")
  updatedAt DateTime @updatedAt
}

model StudentPortals {
  id        Int      @id @default(autoincrement())
  studentId Int      @unique
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  portals   Json     @default("[]")
  updatedAt DateTime @updatedAt
}

model StudentDecide {
  id                Int      @id @default(autoincrement())
  studentId         Int      @unique
  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  decisions         Json     @default("[]")
  aiRecommendations Json     @default("{}")
  updatedAt         DateTime @updatedAt
}

model StudentFinancialAid {
  id                 Int      @id @default(autoincrement())
  studentId          Int      @unique
  student            Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fafsaChecklist     Json     @default("{}")
  scholarshipAnswers Json     @default("{}")
  aiRecommendations  Json     @default("{}")
  updatedAt          DateTime @updatedAt
}

model StudentDeadlines {
  id              Int      @id @default(autoincrement())
  studentId       Int      @unique
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  manualDeadlines Json     @default("[]")
  updatedAt       DateTime @updatedAt
}

// Express session store (connect-pg-simple).
// Must match the table structure that connect-pg-simple expects.
model Session {
  sid    String   @id @db.VarChar(255)
  sess   Json
  expire DateTime @db.Timestamptz(6)

  @@index([expire])
  @@map("session")
}
